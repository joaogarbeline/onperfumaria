PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onperfumaria?sslmode=disable
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173
AUTO_SEED=true
# Optional: password for the seeded admin user (admin@onperfumaria.com). Defaults to admin123 if unset.
ADMIN_PASSWORD=admin123
DEFAULT_TAX_FEE=4.5
# Credenciais da aplicacao Mercado Pago (nao e o access token de uma conta especifica).
# Crie/reutilize em https://www.mercadopago.com.br/developers/panel/app
# e cadastre a Redirect URI: <FRONTEND_URL>/api/mercadopago/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
